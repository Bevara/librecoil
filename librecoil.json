{
    "name": "librecoil",
    "description": "Retro computer image decoder (IFF/ILBM, Degas, ...)",
    "filters":["recoildec"],
    "help": "This filter decodes retro computer picture formats (Amiga IFF/ILBM, Atari ST Degas PI1/PC1, and many others) using RECOIL.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/librecoil.accessor",
    "filter_source":{
        "recoildec" : "dec_recoil.c"
    },
    "extension":{
      "iff" : "img",
      "ilbm" : "img",
      "lbm" : "img",
      "pi1" : "img",
      "pc1" : "img"
    },
    "licence_required":false
}
